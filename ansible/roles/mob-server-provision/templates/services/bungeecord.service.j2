#!/bin/bash
 
### BEGIN INIT INFO
# Provides:   bungeecord
# Required-Start: $local_fs $remote_fs screen-cleanup
# Required-Stop:  $local_fs $remote_fs
# Should-Start:   $network
# Should-Stop:    $network
# Default-Start:  2 3 4 5
# Default-Stop:   0 1 6
# Short-Description:    Bungeecord server
# Description:    Starts the bungeecord server
### END INIT INFO
 
# Settings
SERVICE='BungeeCord.jar'
USERNAME='minecraft'
SCREENNAME='proxy'
SERVICEPATH='/home/minecraft/mob-servers/bungeecord'
MAXHEAP={{ servers_memory_allocation.bungeecord }}
MINHEAP={{ servers_memory_allocation.bungeecord }}
HISTORY=512
INVOCATION="java -Xmx${MAXHEAP} -Xms${MINHEAP} \
-Dio.netty.recycler.maxCapacity.default=20000 -XX:G1HeapRegionSize=4M -Dfile.encoding=UTF-8 \
-jar $SERVICE"

ME=$(whoami)
as_user() {
  if [ "$ME" = "$USERNAME" ] ; then
    bash -c "$1"
  else
    su -s /bin/bash - "$USERNAME" -c "$1"
  fi
}

is_running() {
  pgrep -u "$USERNAME" -f "$SERVICE" > /dev/null 2>&1
}

bg_start() {
  if is_running
  then
    echo "$SERVICE is already running!"
    return 0
  else
    echo "Starting $SERVICE..."
    as_user "cd '$SERVICEPATH' && screen -h $HISTORY -dmS $SCREENNAME $INVOCATION"
    
    # Wait up to 10 seconds for service to start
    for i in {1..10}; do
      sleep 1
      if is_running; then
        echo "$SERVICE is now running."
        return 0
      fi
    done
    
    echo "Error! Could not start $SERVICE!"
    return 1
  fi
}

bg_stop() {
  if is_running
  then
    echo "Stopping $SERVICE"
    as_user "screen -p 0 -S $SCREENNAME -X eval 'stuff \"end\"\015'"
    
    # Wait up to 15 seconds for graceful shutdown
    for i in {1..15}; do
      sleep 1
      if ! is_running; then
        echo "$SERVICE is stopped."
        return 0
      fi
    done
    
    echo "Error! $SERVICE could not be stopped gracefully."
    return 1
  else
    echo "$SERVICE was not running."
    return 0
  fi
}

# The main events processor
case "$1" in
  start)
    bg_start
    ;;
  stop)
    bg_stop
    ;;
  restart)
    bg_stop
    bg_start
    ;;
  status)
    if is_running
    then
      echo "$SERVICE is running."
      exit 0
    else
      echo "$SERVICE is not running."
      exit 3
    fi
    ;;
  *)
  echo "Usage: $0 {start|stop|status|restart}"
  exit 1
  ;;
esac
exit $?