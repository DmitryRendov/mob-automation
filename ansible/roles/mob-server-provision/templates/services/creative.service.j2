#!/bin/bash

### BEGIN INIT INFO
# Provides:       creative
# Required-Start: $local_fs $remote_fs screen-cleanup
# Required-Stop:  $local_fs $remote_fs
# Should-Start:   $network
# Should-Stop:    $network
# Default-Start:  2 3 4 5
# Default-Stop:   0 1 6
# Short-Description:    Minecraft server
# Description:    Starts the minecraft server
### END INIT INFO
 
# Settings
SERVICE='paper-creative-{{ server_version }}.jar'
OPTIONS='--nogui'
USERNAME='minecraft'
SCREENNAME='creative'
WORLD='creative'
MCPATH='{{ server_folder }}/creative'
BACKUPPATH='{{ backup_folder }}'
MAXHEAP={{ servers_configuration.creative.memory }}
MINHEAP={{ servers_configuration.creative.memory }}
HISTORY=512
CPU_COUNT={{ servers_configuration.creative.cpus }}
INVOCATION="java -Xmx${MAXHEAP} -Xms${MINHEAP} -XX:ParallelGCThreads=$CPU_COUNT \
-XX:+UseG1GC -XX:+UnlockExperimentalVMOptions -XX:MaxGCPauseMillis=50 \
-XX:+DisableExplicitGC -XX:TargetSurvivorRatio=90 -XX:G1NewSizePercent=50 \
-XX:G1MaxNewSizePercent=80 -XX:InitiatingHeapOccupancyPercent=10 \
-XX:G1MixedGCLiveThresholdPercent=50 \
-XX:+AlwaysPreTouch -Dfile.encoding=UTF-8 \
-XX:+HeapDumpOnOutOfMemoryError \
-jar $SERVICE $OPTIONS"

# Dirs and userdata to backup
D2BACKUP[0]='creative'

ME=$(whoami)
as_user() {
  if [ "$ME" = "$USERNAME" ] ; then
    bash -c "$1"
  else
    su -s /bin/bash - "$USERNAME" -c "$1"
  fi
}

is_running() {
  pgrep -u "$USERNAME" -f "$SERVICE" > /dev/null 2>&1
}

mc_start() {
  if is_running
  then
    echo "$SERVICE is already running!"
    return 0
  else
    echo "Starting $SERVICE..."
    as_user "cd '$MCPATH' && screen -h $HISTORY -dmS $SCREENNAME $INVOCATION"
    
    # Wait up to 15 seconds for service to start
    for i in {1..15}; do
      sleep 1
      if is_running; then
        echo "$SERVICE is now running."
        return 0
      fi
    done
    
    echo "Error! Could not start $SERVICE!"
    return 1
  fi
}

mc_stop() {
  if is_running
  then
    echo "Stopping $SERVICE"
    as_user "screen -p 0 -S $SCREENNAME -X eval 'stuff \"say Сервер БУДЕТ ВЫКЛЮЧЕН через 10 секунд. Сохраняем мир...\"\015'"
    as_user "screen -p 0 -S $SCREENNAME -X eval 'stuff \"save-all\"\015'"
    sleep 10
    as_user "screen -p 0 -S $SCREENNAME -X eval 'stuff \"stop\"\015'"
    
    # Wait up to 20 seconds for graceful shutdown
    for i in {1..20}; do
      sleep 1
      if ! is_running; then
        echo "$SERVICE is stopped."
        return 0
      fi
    done
    
    echo "Error! $SERVICE could not be stopped gracefully."
    return 1
  else
    echo "$SERVICE was not running."
    return 0
  fi
}

mc_saveoff() {
  if is_running
  then
    echo ""
    echo "$SERVICE is running... suspending saves"
    as_user "screen -p 0 -S $SCREENNAME -X eval 'stuff \"say Выполняется резервное копирование. Переключение в режим Только чтение...\"\015'"
    as_user "screen -p 0 -S $SCREENNAME -X eval 'stuff \"save-off\"\015'"
    as_user "screen -p 0 -S $SCREENNAME -X eval 'stuff \"save-all\"\015'"
    sync
    sleep 10
  else
    echo "$SERVICE is not running. Not suspending saves."
  fi
}

mc_saveon() {
  if is_running
  then
    echo ""
    echo "$SERVICE is running... re-enabling saves"
    as_user "screen -p 0 -S $SCREENNAME -X eval 'stuff \"save-on\"\015'"
    as_user "screen -p 0 -S $SCREENNAME -X eval 'stuff \"say Резервное копирование успешно завершено. Переключение в обычный режим...\"\015'"
  else
    echo "$SERVICE is not running. Not resuming saves."
 fi
}

mc_backup() {
   mc_saveoff

   umask 077
   NOW=$(date "+%Y-%m-%d_%Hh%M")
   BACKUP_FILE="$BACKUPPATH/${WORLD}_${NOW}.tar"

   echo ""
   echo "Removing old backups..."
   echo "" 
   find "$BACKUPPATH" -name "*.gz" -mtime +14 -exec rm {} \;

   echo ""
   echo "Backing up minecraft world..."
   echo "" 

   for object in "${D2BACKUP[@]}"
   do
      echo ""
      echo -n "Backing up ${object}... "
      if as_user "tar -C '$MCPATH' -rf '$BACKUP_FILE' $object" 2>/dev/null; then
        echo "done"
      else
        echo "failed"
      fi
   done

   mc_saveon

   echo ""
   echo "Compressing backup..."
   if as_user "gzip -f '$BACKUP_FILE'"; then
     chmod 0600 "${BACKUP_FILE}.gz"
     echo "Done."
   else
     echo "Compression failed!"
     return 1
   fi
}
 
mc_command() {
  command="$1"
  if is_running
  then
    pre_log_len=$(wc -l "$MCPATH/logs/latest.log" | awk '{print $1}')
    echo "$SERVICE is running... executing command"
    as_user "screen -p 0 -S $SCREENNAME -X eval 'stuff \"$command\"\015'"
    sleep .1
    # print output
    tail -n $(($(wc -l "$MCPATH/logs/latest.log" | awk '{print $1}') - pre_log_len)) "$MCPATH/logs/latest.log"
  else
    echo "$SERVICE is not running."
    return 1
  fi
}

# The main events processor
case "$1" in
  start)
    mc_start
    ;;
  stop)
    mc_stop
    ;;
  restart)
    mc_stop
    mc_start
    ;;
  backup)
    mc_backup
    ;;
  status)
    if is_running
    then
      echo "$SERVICE is running."
      exit 0
    else
      echo "$SERVICE is not running."
      exit 3
    fi
    ;;
  command)
    if [ $# -gt 1 ]; then
      shift
      mc_command "$*"
    else
      echo "Must specify server command (try 'help'?)"
      exit 1
    fi
    ;;

  *)
  echo "Usage: $0 {start|stop|backup|status|restart|command \"server command\"}"
  exit 1
  ;;
esac
exit $?