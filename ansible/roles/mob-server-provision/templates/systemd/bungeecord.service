[Unit]
Description=MOB Proxy Server
After=network.target local-fs.target
Wants=firewalld.service

[Service]
Type=forking
WorkingDirectory=/home/minecraft/mob-servers/bungeecord
ExecStart=/opt/minecraft/bungeecord start
ExecStop=/opt/minecraft/bungeecord stop
User=minecraft
Group=minecraft
RestartSec=60
Restart=always

[Install]
WantedBy=multi-user.target
