[Unit]
Description=MOB Vanilla Server (Minecraft)
After=network.target local-fs.target
Wants=firewalld.service

[Service]
Type=forking
WorkingDirectory=/home/minecraft/mob-servers/vanilla
User=minecraft
Group=minecraft

# Start the service
ExecStart=/opt/minecraft/vanilla start

# Stop the service gracefully
ExecStop=/opt/minecraft/vanilla stop

# Enhanced reliability
Restart=on-failure
RestartSec=60
TimeoutStartSec=60
TimeoutStopSec=30

# Resource limits
LimitNOFILE=4096

# Security hardening for Ubuntu 24.04
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/minecraft/mob-servers/vanilla /home/minecraft/backups/worlds

[Install]
WantedBy=multi-user.target
